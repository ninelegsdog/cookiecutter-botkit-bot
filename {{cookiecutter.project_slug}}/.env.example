# Example environment for the generated bot. Copy to .env and fill in the secrets.
# Read by the project's Settings — environment prefix BOTKIT_ (matches docker-compose.yml).

BOTKIT_BOT_TOKEN=      # REQUIRED — token from @BotFather
BOTKIT_ADMIN_IDS=      # REQUIRED — comma-separated numeric Telegram user IDs
BOTKIT_DATABASE_URL=sqlite+aiosqlite:///data/app.db
BOTKIT_REDIS_URL=redis://redis:6379/0
BOTKIT_SENTRY_DSN=
BOTKIT_METRICS_PORT={{ cookiecutter.port }}
