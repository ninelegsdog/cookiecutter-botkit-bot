# Example environment for the generated bot. Copy to .env and fill in the secrets.
# Names match src/core/config.py: flat names, no prefix (see the BotKit portfolio).

TELEGRAM_BOT_TOKEN=      # REQUIRED — token from @BotFather
ADMIN_IDS=               # comma-separated numeric Telegram user IDs
DATABASE_URL=sqlite+aiosqlite:///data/app.db
REDIS_URL=redis://redis:6379/0
WEBHOOK_URL=             # leave empty to run in long-polling mode
WEBHOOK_SECRET_TOKEN=
SENTRY_DSN=
METRICS_PORT={{ cookiecutter.port }}
